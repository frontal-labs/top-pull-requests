{
	"name": "@frontal/top-pull-requests",
	"description": "Frontal tool that surfaces the most important pull requests by analyzing waiting times, change sizes, review activity, and reviewer assignments",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "bun scripts/pull-requests.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"format": "biome format --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@octokit/rest": "^20.0.2",
		"@t3-oss/env-core": "^0.13.11",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.2.0",
		"@types/bun": "^1.3.5",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^1.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"typescript": "^5.7.2",
		"vitest": "^1.6.0"
	},
	"keywords": ["github", "pull-requests", "analytics", "slack", "reviews"]
}
