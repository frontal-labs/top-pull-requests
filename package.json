{
  "name": "@frontal/top-pull-requests",
  "version": "0.0.1",
  "private": true,
  "description": "Frontal tool that surfaces the most important pull requests by analyzing waiting times, change sizes, review activity, and reviewer assignments",
  "keywords": [
    "github",
    "pull-requests",
    "analytics",
    "slack",
    "reviews"
  ],
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "generate": "bun scripts/pull-requests.ts",
    "lint": "biome check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.7.2",
    "ultracite": "^8.1.0",
    "vitest": "^1.6.0"
  }
}
